<script>
(function () {
  var root = document.getElementById('clayo');
  if (!root) return;

  // Heat level + massage mode selectors (radio groups with arrow-key navigation)
  var rings = root.querySelector('#c-rings');
  var temp = root.querySelector('#c-temp');
  var label = root.querySelector('#c-label');
  var live = root.querySelector('#c-live');
  var modeBars = root.querySelectorAll('#c-screen-modes span');
  var state = { level: null, mode: null };

  function render() {
    var lv = state.level, md = state.mode;
    if (!lv || !md) return;
    var levelIdx = Array.prototype.indexOf.call(lv.parentNode.children, lv);
    var modeIdx = Array.prototype.indexOf.call(md.parentNode.children, md);
    rings.style.setProperty('--s', lv.dataset.scale);
    rings.style.setProperty('--pulse', md.dataset.pulse);
    rings.querySelectorAll('i').forEach(function (r) { r.style.transform = 'scale(' + lv.dataset.scale + ')'; });
    modeBars.forEach(function (b, i) { b.classList.toggle('is-on', i === modeIdx); });
    temp.textContent = lv.dataset.temp + '°';
    label.textContent = 'Level ' + (levelIdx + 1) + ' · ' + lv.dataset.name + ' · ' + md.dataset.name;
    live.textContent = 'Heat level ' + (levelIdx + 1) + ', ' + lv.dataset.name + ', ' + lv.dataset.temp + ' degrees. Massage mode M' + (modeIdx + 1) + ', ' + md.dataset.name + '.';
  }

  root.querySelectorAll('[role="radiogroup"]').forEach(function (group) {
    var key = group.dataset.group;
    var radios = Array.prototype.slice.call(group.querySelectorAll('[role="radio"]'));
    function select(btn, focus) {
      radios.forEach(function (r) {
        var on = r === btn;
        r.setAttribute('aria-checked', on ? 'true' : 'false');
        r.tabIndex = on ? 0 : -1;
      });
      if (focus) btn.focus();
      state[key] = btn;
      render();
    }
    radios.forEach(function (r, i) {
      r.addEventListener('click', function () { select(r, false); });
      r.addEventListener('keydown', function (e) {
        var next = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = radios[(i + 1) % radios.length];
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = radios[(i - 1 + radios.length) % radios.length];
        else if (e.key === 'Home') next = radios[0];
        else if (e.key === 'End') next = radios[radios.length - 1];
        if (next) { e.preventDefault(); select(next, true); }
      });
    });
    select(group.querySelector('[aria-checked="true"]') || radios[0], false);
  });

  // Loading state on add-to-cart submit
  root.querySelectorAll('.c-cart-form').forEach(function (form) {
    form.addEventListener('submit', function () {
      var btn = form.querySelector('button[type="submit"]');
      if (!btn || btn.disabled) return;
      btn.setAttribute('aria-busy', 'true');
      btn.textContent = 'Adding…';
    });
  });
  // Restore buttons if the page is shown again from the back/forward cache
  window.addEventListener('pageshow', function (e) {
    if (!e.persisted) return;
    root.querySelectorAll('.c-btn[aria-busy="true"]').forEach(function (b) {
      b.removeAttribute('aria-busy');
      b.textContent = b.dataset.label;
    });
  });
  root.querySelectorAll('.c-cart-form .c-btn').forEach(function (b) { b.dataset.label = b.textContent; });

  // Scroll reveal
  var els = root.querySelectorAll('.c-reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  } else {
    els.forEach(function (el) { el.classList.add('is-in'); });
  }

  // Sticky mobile add-to-cart: only once the hero button has scrolled away,
  // and hidden again while the final CTA is on screen (one primary CTA per view).
  var sticky = root.querySelector('#c-sticky');
  var heroForm = root.querySelector('.c-form');
  var finalForm = root.querySelector('#c-final-form');
  if (sticky && heroForm && finalForm && 'IntersectionObserver' in window) {
    var passedHero = false, finalVisible = false;
    var stickyBtn = sticky.querySelector('button');
    function update() {
      var on = passedHero && !finalVisible;
      sticky.classList.toggle('is-on', on);
      sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
      stickyBtn.tabIndex = on ? 0 : -1;
    }
    new IntersectionObserver(function (entries) {
      var e = entries[0];
      passedHero = !e.isIntersecting && e.boundingClientRect.top < 0;
      update();
    }).observe(heroForm);
    new IntersectionObserver(function (entries) {
      finalVisible = entries[0].isIntersecting;
      update();
    }).observe(finalForm);
  }
})();
</script>
</div>

