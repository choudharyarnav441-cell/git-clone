{%- comment -%} Generated by build.mjs from src/landing.html — edit the source, not this file. {%- endcomment -%}
{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<!--
  clayo landing page — single source template.
  Double-underscore tokens are filled by build.mjs:
    - preview/index.html                    → sample values for local viewing
    - shopify/sections/clayo-landing.liquid → Liquid product data
  All visual values come from the design tokens declared on .clayo below.
-->
<div class="clayo" id="clayo">
<style>
  .clayo {
    /* Color — surfaces */
    --color-5: #F6C1B3;
    --color-6: #F8EAE5;
    --color-7: #FAEAE6;
    /* Color — text */
    --color-1: #121212;
    --color-2: #534B46;
    --color-3: #8C7F78;
    --color-4: #D88F79;
    --color-8: #F7F3EC;
    --color-9: #FFF7F3;
    --color-10: #FFFFFF;

    /* Typography */
    --font: "Poppins", Arial, "Times New Roman", sans-serif;
    --text-xs: 10px;
    --text-sm: 12px;
    --text-base: 13px;
    --text-lg: 16px;
    --text-xl: 17px;
    --text-2xl: 34px;
    --text-3xl: 52px;
    --text-4xl: 88px;

    /* Spacing */
    --space-1: 1px;  --space-2: 2px;  --space-3: 4px;  --space-4: 5px;
    --space-5: 7px;  --space-6: 8px;  --space-7: 12px; --space-8: 13px;
    --space-9: 15px; --space-10: 16px; --space-11: 19px; --space-12: 20px;
    --space-13: 22px; --space-14: 26px; --space-15: 30px; --space-16: 32px;
    --space-17: 34px; --space-18: 36px; --space-19: 40px; --space-20: 48px;
    --space-21: 56px; --space-22: 60px; --space-23: 76px; --space-24: 98px;

    /* Shape */
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 18px;
    --radius-xl: 999px;

    /* Motion */
    --duration-fast: 0.15s;
    --duration-base: 0.2s;
    --duration-slow: 0.3s;
    --ease: ease-in-out;

    font-family: var(--font);
    font-size: var(--text-lg);
    color: var(--color-1);
    background: var(--color-10);
    -webkit-font-smoothing: antialiased;
    line-height: 1.6;
    overflow-x: clip;
  }
  .clayo *, .clayo *::before, .clayo *::after { box-sizing: border-box; }
  .clayo img { max-width: 100%; display: block; }
  .clayo a { color: inherit; }
  .clayo h1, .clayo h2, .clayo h3 { font-weight: 600; letter-spacing: -0.02em; margin: 0; line-height: 1.15; }
  .clayo p { margin: 0; }
  .clayo :focus-visible { outline: var(--space-2) solid var(--color-1); outline-offset: var(--space-3); border-radius: var(--radius-sm); }
  .c-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .c-wrap { width: min(1200px, 100% - 2 * var(--space-10)); margin-inline: auto; }
  .c-eyebrow { display: inline-flex; align-items: center; gap: var(--space-6); font-size: var(--text-base); font-weight: 600; color: var(--color-2); }
  .c-eyebrow::before { content: ""; width: var(--space-6); height: var(--space-6); border-radius: var(--radius-xl); background: var(--color-4); }
  .c-mark { background: linear-gradient(transparent 60%, var(--color-5) 60%, var(--color-5) 92%, transparent 92%); padding-inline: var(--space-2); }
  .c-stars { display: inline-flex; gap: var(--space-2); color: var(--color-1); }
  .c-stars svg { width: var(--space-9); height: var(--space-9); fill: currentColor; }

  /* Ticker */
  .c-ticker { background: var(--color-1); color: var(--color-8); font-size: var(--text-sm); overflow: hidden; padding: var(--space-6) 0; }
  .c-ticker-track { display: flex; width: max-content; animation: horTicker 50s linear infinite forwards; }
  .c-ticker-track span { white-space: nowrap; padding-inline: var(--space-19); position: relative; }
  .c-ticker-track span::after { content: "✦"; position: absolute; right: calc(-1 * var(--space-4)); color: var(--color-4); }
  .c-ticker:hover .c-ticker-track { animation-play-state: paused; }
  @keyframes horTicker { to { transform: translateX(-50%); } }

  /* Nav */
  .c-nav { position: sticky; top: 0; z-index: 20; background: var(--color-10); border-bottom: var(--space-1) solid var(--color-6); }
  .c-nav .c-wrap { display: flex; align-items: center; justify-content: space-between; gap: var(--space-12); height: 64px; }
  .c-logo { font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.05em; line-height: 1; text-decoration: none; }
  .c-logo span { color: var(--color-4); }
  .c-links { display: flex; gap: var(--space-16); font-size: var(--text-base); font-weight: 500; }
  .c-links a { text-decoration: none; color: var(--color-2); transition: color var(--duration-base); }
  .c-links a:hover { color: var(--color-1); }
  .c-cart { display: inline-flex; align-items: center; gap: var(--space-6); font-size: var(--text-base); font-weight: 500; text-decoration: none; border: var(--space-1) solid var(--color-1); padding: var(--space-6) var(--space-10); border-radius: var(--radius-xl); transition: background var(--duration-base), color var(--duration-base); }
  .c-cart:hover { background: var(--color-1); color: var(--color-10); }
  .c-cart svg { width: var(--space-10); height: var(--space-10); fill: none; stroke: currentColor; stroke-width: 1.6; }

  /* Buttons */
  .c-btn { appearance: none; border: 0; cursor: pointer; font: 600 var(--text-lg)/1 var(--font); display: inline-flex; align-items: center; justify-content: center; gap: var(--space-7); padding: var(--space-11) var(--space-16); border-radius: var(--radius-xl); background: var(--color-1); color: var(--color-10); text-decoration: none; transition: background var(--duration-base), transform var(--duration-fast); }
  .c-btn:hover { background: var(--color-2); }
  .c-btn:active { transform: translateY(var(--space-1)); }
  .c-btn:disabled { background: var(--color-3); color: var(--color-8); cursor: not-allowed; transform: none; }
  .c-btn[aria-busy="true"] { pointer-events: none; }
  .c-btn[aria-busy="true"]::before { content: ""; width: var(--space-10); height: var(--space-10); border-radius: var(--radius-xl); border: var(--space-2) solid currentColor; border-right-color: transparent; animation: c-spin .7s linear infinite; }
  .c-btn--block { width: 100%; }
  .c-btn--light { background: var(--color-5); color: var(--color-1); }
  .c-btn--light:hover { background: var(--color-10); }
  .c-btn--light:focus-visible { outline-color: var(--color-5); }
  @keyframes c-spin { to { transform: rotate(360deg); } }

  /* Hero */
  .c-hero { padding: var(--space-20) 0 var(--space-23); }
  .c-hero .c-wrap { display: grid; grid-template-columns: 1fr 1.05fr; gap: var(--space-21); align-items: center; }
  .c-rating { display: inline-flex; align-items: center; gap: var(--space-6); font-size: var(--text-base); color: var(--color-2); background: var(--color-7); padding: var(--space-4) var(--space-7) var(--space-4) var(--space-6); border-radius: var(--radius-xl); }
  .c-hero h1 { font-size: var(--text-3xl); margin: var(--space-12) 0 var(--space-10); }
  .c-hero-sub { color: var(--color-2); max-width: 42ch; }
  .c-benefits { list-style: none; padding: 0; margin: var(--space-14) 0 0; display: grid; gap: var(--space-6); font-size: var(--text-lg); }
  .c-benefits li { display: flex; align-items: center; gap: var(--space-7); }
  .c-benefits svg { flex: none; width: var(--space-12); height: var(--space-12); padding: var(--space-3); border-radius: var(--radius-xl); background: var(--color-5); stroke: var(--color-1); stroke-width: 3; fill: none; }
  .c-buybox { margin-top: var(--space-16); padding: var(--space-13); border-radius: var(--radius-lg); background: var(--color-9); border: var(--space-1) solid var(--color-6); }
  .c-price { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-7); margin-bottom: var(--space-10); }
  .c-price strong { font-size: var(--text-2xl); font-weight: 600; line-height: 1; }
  .c-price s { color: var(--color-3); font-size: var(--text-lg); }
  .c-save { background: var(--color-5); color: var(--color-1); font-size: var(--text-sm); font-weight: 600; padding: var(--space-3) var(--space-7); border-radius: var(--radius-xl); }
  .c-assure { list-style: none; padding: 0; margin: var(--space-10) 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-6) var(--space-12); font-size: var(--text-sm); color: var(--color-2); }
  .c-assure li { display: inline-flex; align-items: center; gap: var(--space-4); }
  .c-assure svg { width: var(--space-10); height: var(--space-10); fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .c-visual { position: relative; }
  .c-visual-frame { position: relative; background: var(--color-7); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1; isolation: isolate; }
  .c-visual-frame::before { content: ""; position: absolute; left: 52%; top: 50%; width: 88%; aspect-ratio: 1; border-radius: var(--radius-xl); background: var(--color-9); transform: translate(-50%, -50%); z-index: -1; animation: c-breathe 5s var(--ease) infinite; }
  .c-visual-frame img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; }
  .c-chip { position: absolute; background: var(--color-10); border: var(--space-1) solid var(--color-5); border-radius: var(--radius-md); padding: var(--space-7) var(--space-10); font-size: var(--text-sm); color: var(--color-2); animation: c-float 6s var(--ease) infinite; }
  .c-chip b { display: block; font-size: var(--text-xl); font-weight: 600; color: var(--color-1); line-height: 1.3; }
  .c-chip--temp { left: calc(-1 * var(--space-13)); bottom: 14%; }
  .c-chip--time { right: calc(-1 * var(--space-12)); top: 10%; animation-delay: -3s; }
  .c-dot { display: inline-block; width: var(--space-6); height: var(--space-6); border-radius: var(--radius-xl); background: var(--color-4); margin-right: var(--space-4); animation: c-pulse 2s infinite; }
  @keyframes c-float { 50% { transform: translateY(calc(-1 * var(--space-6))); } }
  @keyframes c-breathe { 50% { transform: translate(-50%, -50%) scale(1.04); } }
  @keyframes c-pulse { 0% { box-shadow: 0 0 0 0 var(--color-5); } 70%, 100% { box-shadow: 0 0 0 var(--space-6) transparent; } }

  /* Stats */
  .c-stats { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-block: var(--space-1) solid var(--color-6); }
  .c-stats li { padding: var(--space-16) var(--space-13); }
  .c-stats li + li { border-left: var(--space-1) solid var(--color-6); }
  .c-stats b { display: block; font-size: var(--text-2xl); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .c-stats span { font-size: var(--text-base); color: var(--color-2); }

  /* Sections */
  .c-section { padding: var(--space-24) 0; }
  .c-section--blush { background: var(--color-7); }
  .c-section--cream { background: var(--color-8); }
  .c-head { max-width: 680px; margin-bottom: var(--space-20); }
  .c-head h2 { font-size: var(--text-2xl); margin-top: var(--space-7); }
  .c-head p { margin-top: var(--space-10); color: var(--color-2); }

  /* Heat + massage dial */
  .c-dial { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); }
  .c-stage { position: relative; border-radius: var(--radius-lg); background: var(--color-5); aspect-ratio: 1 / .92; display: grid; place-items: center; overflow: hidden; isolation: isolate; }
  .c-rings { position: absolute; inset: 0; display: grid; place-items: center; z-index: -1; }
  .c-rings i { position: absolute; aspect-ratio: 1; border-radius: var(--radius-xl); background: color-mix(in srgb, var(--color-7) var(--a), transparent); transition: transform var(--duration-slow) var(--ease); }
  .c-rings i:nth-child(1) { width: 92%; --a: 40%; }
  .c-rings i:nth-child(2) { width: 68%; --a: 60%; }
  .c-rings i:nth-child(3) { width: 44%; --a: 90%; }
  .c-rings.is-pulsing i { animation: c-ring var(--pulse, 2s) var(--ease) infinite; }
  .c-rings.is-pulsing i:nth-child(2) { animation-delay: calc(var(--pulse, 2s) / -3); }
  .c-rings.is-pulsing i:nth-child(3) { animation-delay: calc(var(--pulse, 2s) / -1.5); }
  @keyframes c-ring { 50% { transform: scale(calc(var(--s, 1) * 1.05)); } }
  .c-screen { background: var(--color-1); color: var(--color-5); border-radius: var(--radius-lg); padding: var(--space-13) var(--space-17) var(--space-12); min-width: 62%; text-align: center; }
  .c-screen-modes { display: flex; justify-content: center; gap: var(--space-10); font-size: var(--text-xs); font-weight: 600; color: var(--color-3); }
  .c-screen-modes span { display: grid; gap: var(--space-3); justify-items: center; transition: color var(--duration-base); }
  .c-screen-modes span::before { content: ""; width: var(--space-12); height: var(--space-2); border-radius: var(--radius-xl); background: currentColor; }
  .c-screen-modes .is-on { color: var(--color-5); }
  .c-screen-temp { display: block; font-size: var(--text-4xl); font-weight: 500; letter-spacing: -0.04em; line-height: 1; margin: var(--space-6) 0 var(--space-4); font-variant-numeric: tabular-nums; }
  .c-screen-label { font-size: var(--text-sm); color: var(--color-8); }
  .c-panel { border-radius: var(--radius-lg); background: var(--color-10); padding: var(--space-16); display: flex; flex-direction: column; gap: var(--space-14); }
  .c-group-label { font-size: var(--text-base); font-weight: 600; margin-bottom: var(--space-7); }
  .c-levels { display: grid; gap: var(--space-6); }
  .c-level { all: unset; box-sizing: border-box; cursor: pointer; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-10); padding: var(--space-7) var(--space-10); border-radius: var(--radius-md); border: var(--space-1) solid var(--color-6); background: var(--color-9); transition: border-color var(--duration-base), background var(--duration-base); }
  .c-level:hover { border-color: var(--color-4); }
  .c-level:focus-visible { outline: var(--space-2) solid var(--color-1); outline-offset: var(--space-2); }
  .c-level[aria-checked="true"] { background: var(--color-10); border-color: var(--color-1); }
  .c-level-n { width: var(--space-18); height: var(--space-18); border-radius: var(--radius-xl); display: grid; place-items: center; background: var(--color-7); font-weight: 600; font-size: var(--text-base); transition: background var(--duration-base), color var(--duration-base); }
  .c-level[aria-checked="true"] .c-level-n { background: var(--color-1); color: var(--color-10); }
  .c-level-t strong { display: block; font-size: var(--text-lg); font-weight: 600; line-height: 1.3; }
  .c-level-t span { font-size: var(--text-base); color: var(--color-2); }
  .c-level-temp { font-size: var(--text-xl); font-weight: 600; }
  .c-modes { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  .c-mode { all: unset; box-sizing: border-box; cursor: pointer; text-align: center; padding: var(--space-7) var(--space-3); border-radius: var(--radius-md); border: var(--space-1) solid var(--color-6); background: var(--color-9); transition: border-color var(--duration-base), background var(--duration-base), color var(--duration-base); }
  .c-mode strong { display: block; font-size: var(--text-lg); font-weight: 600; line-height: 1.3; }
  .c-mode span { font-size: var(--text-sm); color: var(--color-2); }
  .c-mode:hover { border-color: var(--color-4); }
  .c-mode:focus-visible { outline: var(--space-2) solid var(--color-1); outline-offset: var(--space-2); }
  .c-mode[aria-checked="true"] { background: var(--color-1); border-color: var(--color-1); color: var(--color-10); }
  .c-mode[aria-checked="true"] span { color: var(--color-5); }
  .c-note { font-size: var(--text-sm); color: var(--color-2); }

  /* Anatomy */
  .c-anatomy { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-21); align-items: center; }
  .c-anatomy-img { position: relative; background: var(--color-8); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1; }
  .c-anatomy-img img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; }
  .c-hot { position: absolute; width: var(--space-14); height: var(--space-14); margin: calc(-1 * var(--space-7)) 0 0 calc(-1 * var(--space-7)); border-radius: var(--radius-xl); display: grid; place-items: center; background: var(--color-1); color: var(--color-10); font-size: var(--text-base); font-weight: 600; box-shadow: 0 0 0 var(--space-4) color-mix(in srgb, var(--color-10) 70%, transparent); }
  .c-parts { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-12); counter-reset: part; }
  .c-parts li { counter-increment: part; display: grid; grid-template-columns: auto 1fr; gap: var(--space-10); padding-bottom: var(--space-12); border-bottom: var(--space-1) solid var(--color-6); }
  .c-parts li::before { content: counter(part); width: var(--space-14); height: var(--space-14); border-radius: var(--radius-xl); display: grid; place-items: center; background: var(--color-5); font-size: var(--text-base); font-weight: 600; }
  .c-parts h3 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .c-parts p { color: var(--color-2); }

  /* Steps */
  .c-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-12); counter-reset: step; list-style: none; padding: 0; margin: 0; }
  .c-step { counter-increment: step; background: var(--color-10); border-radius: var(--radius-lg); padding: var(--space-16) var(--space-15); }
  .c-step::before { content: "Step " counter(step); display: inline-block; font-size: var(--text-sm); font-weight: 600; background: var(--color-5); padding: var(--space-3) var(--space-7); border-radius: var(--radius-xl); }
  .c-step h3 { font-size: var(--text-2xl); margin: var(--space-12) 0 var(--space-6); }
  .c-step p { color: var(--color-2); }

  /* Comparison */
  .c-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .c-compare { width: 100%; border-collapse: collapse; font-size: var(--text-lg); }
  .c-compare th, .c-compare td { padding: var(--space-10) var(--space-10); text-align: center; border-bottom: var(--space-1) solid var(--color-6); }
  .c-compare th:first-child, .c-compare td:first-child { text-align: left; color: var(--color-2); font-weight: 500; }
  .c-compare thead th { font-size: var(--text-lg); font-weight: 600; color: var(--color-1); }
  .c-compare .is-us { background: var(--color-1); color: var(--color-8); border-bottom-color: var(--color-2); }
  .c-compare thead .is-us { border-radius: var(--radius-lg) var(--radius-lg) 0 0; font-size: var(--text-xl); }
  .c-compare tbody tr:last-child .is-us { border-radius: 0 0 var(--radius-lg) var(--radius-lg); border-bottom: 0; }
  .c-yes { color: var(--color-5); font-weight: 600; }
  .c-no { color: var(--color-3); }

  /* Reviews */
  .c-reviews-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-12); margin-bottom: var(--space-20); }
  .c-reviews-head .c-head { margin: 0; }
  .c-score { display: flex; align-items: center; gap: var(--space-10); }
  .c-score b { font-size: var(--text-3xl); font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
  .c-score span { font-size: var(--text-base); color: var(--color-2); display: block; }
  .c-reviews { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-12); }
  .c-review { background: var(--color-10); border-radius: var(--radius-lg); padding: var(--space-16) var(--space-15); display: flex; flex-direction: column; gap: var(--space-10); }
  .c-review blockquote { margin: 0; font-size: var(--text-xl); font-weight: 500; line-height: 1.5; }
  .c-review footer { margin-top: auto; padding-top: var(--space-10); border-top: var(--space-1) solid var(--color-6); font-size: var(--text-base); color: var(--color-2); display: flex; justify-content: space-between; }
  .c-verified { color: var(--color-1); font-weight: 600; display: inline-flex; align-items: center; gap: var(--space-3); }
  .c-verified::before { content: "✓"; display: grid; place-items: center; width: var(--space-10); height: var(--space-10); border-radius: var(--radius-xl); background: var(--color-5); font-size: var(--text-xs); }

  /* FAQ */
  .c-faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: var(--space-22); }
  .c-faq details { border-bottom: var(--space-1) solid var(--color-6); }
  .c-faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--space-12); padding: var(--space-12) 0; font-size: var(--text-xl); font-weight: 500; }
  .c-faq summary::-webkit-details-marker { display: none; }
  .c-faq summary::after { content: "+"; flex: none; width: var(--space-16); height: var(--space-16); border-radius: var(--radius-xl); display: grid; place-items: center; background: var(--color-7); font-size: var(--text-xl); font-weight: 400; transition: transform var(--duration-slow) var(--ease), background var(--duration-base); }
  .c-faq summary:hover::after { background: var(--color-5); }
  .c-faq details[open] summary::after { transform: rotate(45deg); background: var(--color-5); }
