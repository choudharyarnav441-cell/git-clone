<script>
(function () {
  var root = document.getElementById('clayo');
  if (!root) return;

  // Heat level selector
  var levels = root.querySelectorAll('.c-level');
  var rings = root.querySelectorAll('#c-rings i');
  var temp = root.querySelector('#c-temp');
  var label = root.querySelector('#c-label');
  function setLevel(btn, i) {
    levels.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
    var s = parseFloat(btn.dataset.scale);
    rings.forEach(function (r) { r.style.transform = 'scale(' + s + ')'; r.style.opacity = Math.min(1, .45 + s * .45); });
    temp.textContent = btn.dataset.temp + '°';
    label.textContent = 'Level ' + (i + 1) + ' · ' + btn.dataset.name;
  }
  levels.forEach(function (b, i) { b.addEventListener('click', function () { setLevel(b, i); }); });
  setLevel(levels[1], 1);

  // Scroll reveal
  var els = root.querySelectorAll('.c-reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  } else {
    els.forEach(function (el) { el.classList.add('is-in'); });
  }

  // Sticky mobile add-to-cart once the hero button scrolls away
  var sticky = root.querySelector('#c-sticky');
  var heroForm = root.querySelector('.c-form');
  if (sticky && heroForm && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      sticky.classList.toggle('is-on', !entries[0].isIntersecting && entries[0].boundingClientRect.top < 0);
    }).observe(heroForm);
  }
})();
</script>
